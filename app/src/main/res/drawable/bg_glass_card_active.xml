<?xml version="1.0" encoding="utf-8"?>
<!-- Lit: still translucent, soft gold wash -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#28C9A84B" />
            <stroke
                android:width="1dp"
                android:color="#80D4B86A" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:centerColor="#18C9A84B"
                android:endColor="#12FFFFFF" />
        </shape>
    </item>
</layer-list>
