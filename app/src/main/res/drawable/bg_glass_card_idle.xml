<?xml version="1.0" encoding="utf-8"?>
<!-- Quiet frosted glass: mostly clear, soft gold rim -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#14FFFFFF" />
            <stroke
                android:width="0.8dp"
                android:color="#40C9A84B" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <gradient
                android:angle="270"
                android:startColor="#22FFFFFF"
                android:endColor="#08FFFFFF" />
        </shape>
    </item>
</layer-list>
